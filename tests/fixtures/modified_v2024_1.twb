<?xml version='1.0' encoding='UTF-8'?>
<workbook source-build="20241.24.0320.0919" source-platform="win" version="18.1">
  <datasources>
    <datasource name="sqlserver.sales" caption="Sales">
      <connection class="sqlserver" server="prod.example.com" dbname="sales" username="reader"/>
      <columns>
        <column name="[Territory]" caption="Territory" datatype="string" role="dimension" type="nominal"/>
        <column name="[Sales]" caption="Sales" datatype="real" role="measure" type="quantitative"/>
        <column name="[Profit Ratio]" caption="Profit Ratio" datatype="real" role="measure" type="quantitative">
          <calculation class="tableau" formula="SUM([Sales]) / COUNT([Sales])"/>
        </column>
      </columns>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Sheet 1">
      <table>
        <view>
          <datasources>
            <datasource name="sqlserver.sales"/>
          </datasources>
        </view>
      </table>
    </worksheet>
  </worksheets>
  <dashboards/>
</workbook>
