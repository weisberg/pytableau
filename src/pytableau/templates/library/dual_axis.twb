<workbook source-build="20241.24.0312.0830" source-platform="pytableau-template">
  <datasources>
    <datasource name="__PLACEHOLDER_DS__" caption="__PLACEHOLDER_DS__">
      <connection class="hyper" dbname="__PLACEHOLDER_DS__.hyper"/>
      <columns>
        <column name="__DIMENSION__" caption="__DIMENSION__" datatype="string" role="dimension"/>
        <column name="__MEASURE_BAR__" caption="__MEASURE_BAR__" datatype="real" role="measure"/>
        <column name="__MEASURE_LINE__" caption="__MEASURE_LINE__" datatype="real" role="measure"/>
      </columns>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="__WORKSHEET__">
      <rows>[__MEASURE_BAR__]</rows>
      <cols>[__DIMENSION__]</cols>
      <marks>
        <mark class="Bar"/>
        <dual-axis>
          <mark class="Line" field="[__MEASURE_LINE__]"/>
        </dual-axis>
      </marks>
      <datasource-dependencies>
        <datasource name="__PLACEHOLDER_DS__"/>
      </datasource-dependencies>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="__DASHBOARD__">
      <size type="automatic" width="1200" height="800"/>
    </dashboard>
  </dashboards>
</workbook>
